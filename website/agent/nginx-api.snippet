# lith knapp backend proxy (include inside the lith.vidalion.co server block)
location /api/ {
    proxy_pass http://127.0.0.1:3130/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Must exceed request_timeout_s in providers.json (300s), or nginx 504s
    # while the backend is still waiting on a sketch generation and the user
    # gets a raw gateway error instead of Oldowan's own failure message.
    proxy_read_timeout 330s;
    client_max_body_size 1m;
}
